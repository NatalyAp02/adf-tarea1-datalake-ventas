{
	"name": "df_ventas_onl_br_sl",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ventas_online_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ventas_online_csv",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          timestamp as string,",
				"          product as string,",
				"          qty as string,",
				"          unit_price as string,",
				"          customer as string,",
				"          payment_method as string,",
				"          status as string,",
				"          shipping_cost as string,",
				"          channel as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          id_venta = order_id,",
				"          fecha = timestamp,",
				"          producto = product,",
				"          cantidad = qty,",
				"          precio_unitario = unit_price,",
				"          sucursal = channel,",
				"          vendedor = customer,",
				"          cliente_nombre = status,",
				"          cliente_email = shipping_cost,",
				"          metodo_pago = payment_method",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(id_venta = trim(id_venta),",
				"          fecha = trim(fecha),",
				"          producto = trim(producto),",
				"          cantidad = trim(cantidad),",
				"          precio_unitario = trim(precio_unitario),",
				"          sucursal = trim(sucursal),",
				"          vendedor = trim(vendedor),",
				"          cliente_nombre = trim(cliente_nombre),",
				"          cliente_email = trim(cliente_email),",
				"          metodo_pago = trim(metodo_pago)) ~> derivedColumn1",
				"derivedColumn1 derive(sucursal = iif(\r",
				"    sucursal == 'ONLINE' ||\r",
				"    sucursal == 'Online' ||\r",
				"    sucursal == 'online' ||\r",
				"    sucursal == 'On Line' ||\r",
				"    sucursal == 'on line' ||\r",
				"    sucursal == 'ON LINE' ||\r",
				"    sucursal == 'WEB' ||\r",
				"    sucursal == 'Web' ||\r",
				"    sucursal == 'web',\r",
				"    'online',\r",
				"    sucursal\r",
				"),",
				"          canal = 'Sucursal') ~> derivedColumn2",
				"derivedColumn2 derive(fecha = toString(\r",
				"    coalesce(\r",
				"        toDate(fecha,'yyyy-MM-dd'),\r",
				"        toDate(fecha,'dd-MM-yyyy'),\r",
				"        toDate(fecha,'MM-dd-yyyy'),\r",
				"        toDate(fecha,'dd/MM/yyyy'),\r",
				"        toDate(fecha,'MM/dd/yyyy'),\r",
				"        toDate(fecha,'yyyy/MM/dd'),\r",
				"        toDate(fecha,'dd-MMM-yyyy'),\r",
				"        toDate(fecha,'MMM-dd-yyyy'),\r",
				"        toDate(fecha,'dd.MM.yyyy'),\r",
				"        toDate(fecha,'yyyy.MM.dd')\r",
				"    ),\r",
				"    'yyyy-MM-dd'\r",
				")) ~> derivedColumn3",
				"derivedColumn3 derive(cantidad = toInteger(cantidad),",
				"          precio_unitario = toFloat(regexReplace(toString(precio_unitario),'[^0-9.]',''))) ~> derivedColumn4",
				"derivedColumn4 derive(producto = initCap(regexReplace(producto,'\\\\s+',' '))) ~> derivedColumn5",
				"derivedColumn5 filter(cantidad>0 && !isNull(precio_unitario) && !isNull(fecha) && !isNull(cliente_email) && !isNull(metodo_pago) && !isNull(vendedor)) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          order_id as string,",
				"          timestamp as string,",
				"          product as string,",
				"          qty as string,",
				"          unit_price as string,",
				"          customer as string,",
				"          payment_method as string,",
				"          status as string,",
				"          shipping_cost as string,",
				"          channel as string",
				"     ),",
				"     partitionFileNames:['ventas_onl_limpio.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}